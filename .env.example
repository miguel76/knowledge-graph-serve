# Copy to .env and adapt, or generate it with:
#   docker compose run --rm --no-deps store init <zenodo-record> -o - > .env

# --- What to serve -------------------------------------------------------------------
# Zenodo record: concept DOI (all versions, recommended), version DOI, record id or URL.
ZENODO_RECORD=10.5281/zenodo.24305088
# Follow new versions of the record (default true). Set false to pin a version.
#ZENODO_FOLLOW_LATEST=true
# Files to load (glob patterns); default: every RDF file (.nt .nq .ttl .trig .rdf .owl
# .jsonld .n3, optionally .gz/.bz2/.xz) and every .zip archive containing RDF files.
#KG_FILES=kg.nq.gz void.ttl
#KG_EXCLUDE_FILES=*-sample.ttl
# Named graph for files in triple formats (Turtle, N-Triples, ...): a template with
# {key} {recid} {conceptrecid} {doi} {conceptdoi}, or "default" for the default graph.
#TRIPLES_GRAPH=https://doi.org/{conceptdoi}#{key}
# Needed only for restricted records, or to use the Zenodo sandbox.
#ZENODO_TOKEN=
#ZENODO_API=https://zenodo.org/api
# Seconds between checks for a new version (0: only at start and on `docker compose kill -s HUP store`).
SYNC_INTERVAL=3600

# --- Where to serve it ---------------------------------------------------------------
# Public origin (scheme + host [+ port]) and paths of the service.
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
BASE_PATH=/climate-change-kg
# IRIs starting with KG_BASE_IRI are served at RESOURCE_PATH: e.g.
# https://w3id.org/climate-change-kg/data/x -> ${PUBLIC_URL}/climate-change-kg/id/x
# (configure the redirect at w3id.org / purl.org accordingly).
RESOURCE_PATH=/climate-change-kg/id
# Default: the first void:uriSpace found in the data.
KG_BASE_IRI=https://w3id.org/climate-change-kg/data/
# Title shown in the pages (default: the Zenodo record title).
#KG_TITLE=
# For HTTPS (compose.tls.yaml): the public host name.
#SERVER_NAME=keng.istc.cnr.it

# --- Storage -------------------------------------------------------------------------
#DATA_PATH=./data
# Oxigraph (default backend) options.
#OXIGRAPH_TIMEOUT=60
#OXIGRAPH_UNION_DEFAULT_GRAPH=true
#OXIGRAPH_OPTIMIZE=true
# GraphDB (compose.graphdb.yaml)
#GRAPHDB_REPOSITORY=kg
#GRAPHDB_RULESET=empty
#GRAPHDB_JAVA_OPTS=-Xmx4g
# Fuseki (compose.fuseki.yaml)
#FUSEKI_ADMIN_PASSWORD=change-me
