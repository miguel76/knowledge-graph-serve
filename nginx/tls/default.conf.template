# HTTPS variant (used by compose.tls.yaml). Certificates are managed by certbot.
server {
    listen 80;
    server_name ${SERVER_NAME};
    server_tokens off;
    absolute_redirect off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};
    server_tokens off;
    absolute_redirect off;
    client_max_body_size 1m;

    ssl_certificate /etc/nginx/ssl/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/${SERVER_NAME}/privkey.pem;

    include /etc/nginx/conf.d/kg-locations.inc;
}
