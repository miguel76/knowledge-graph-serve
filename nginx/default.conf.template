# The whole service lives at the root of this server; every URL it generates is relative,
# so a front proxy can mount it under any path (see README: "Publishing").
# ${SPARQL_UPSTREAM} (the store's read-only query endpoint) is set by the compose files, and
# ${SPARQL_UPSTREAM_EXPLICIT}, the one answering without inference (?infer=false): with
# Fuseki another service; with GraphDB the same, which reads infer=false itself.

server {
    listen 80;
    server_tokens off;
    absolute_redirect off;
    client_max_body_size 1m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # SPARQL endpoint (query only). Browsers are sent to the SPARQL editor.
    location = /sparql {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Accept, Content-Type, Authorization" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        if ($http_accept ~* "text/html") {
            return 303 sparql-ui/$is_args$args;
        }
        if ($arg_infer = "false") {
            rewrite ^ /sparql-explicit last;
        }
        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin * always;
        proxy_read_timeout 300s;
        proxy_pass ${SPARQL_UPSTREAM};
    }

    location = /sparql-explicit {
        internal;
        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin * always;
        proxy_read_timeout 300s;
        proxy_pass ${SPARQL_UPSTREAM_EXPLICIT};
    }

    # Everything else: landing page, SPARQL editor, linked data (/id/...), /browse.
    location / {
        proxy_pass http://linked-data:8000;
    }
}
