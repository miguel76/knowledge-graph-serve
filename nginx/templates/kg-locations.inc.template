# Locations of the knowledge graph service, included in the server blocks.
# ${BASE_PATH}, ${RESOURCE_PATH} and ${SPARQL_UPSTREAM} are substituted at container start.

proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;

# SPARQL endpoint (read-only). Browsers are sent to the SPARQL editor.
location = ${BASE_PATH}/sparql {
    if ($request_method = OPTIONS) {
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Accept, Content-Type, Authorization" always;
        add_header Access-Control-Max-Age 86400 always;
        return 204;
    }
    if ($http_accept ~* "text/html") {
        return 303 ${BASE_PATH}/sparql-ui/$is_args$args;
    }
    proxy_hide_header Access-Control-Allow-Origin;
    add_header Access-Control-Allow-Origin * always;
    proxy_read_timeout 300s;
    proxy_pass ${SPARQL_UPSTREAM};
}

# Linked data: resource pages and RDF serialisations.
location ${RESOURCE_PATH}/ {
    proxy_pass http://linked-data:8000;
}

# Landing page, SPARQL editor, /browse, /status.json.
location ${BASE_PATH}/ {
    proxy_pass http://linked-data:8000;
}

location = ${BASE_PATH} {
    return 301 ${BASE_PATH}/;
}

# Site-specific additions (e.g. legacy redirects): nginx/extra/*.inc
include /etc/nginx/extra/*.inc;
