# Sync service with the QLever backend (see compose.qlever.yaml).
# The sync command only needs the Python standard library, so the package is copied in as
# is; the Oxigraph binary converts the RDF formats QLever does not read.
ARG QLEVER_VERSION=commit-2aef66e1ce
ARG OXIGRAPH_VERSION=0.5.13

FROM ghcr.io/oxigraph/oxigraph:${OXIGRAPH_VERSION} AS oxigraph

FROM adfreiburg/qlever:${QLEVER_VERSION}
USER root
COPY --from=oxigraph /usr/local/bin/oxigraph /usr/local/bin/oxigraph
COPY kgserve /app/kgserve
ENV PYTHONPATH=/app DATA_DIR=/data PYTHONUNBUFFERED=1 BACKEND=qlever
RUN python3 -m kgserve --version && oxigraph --version && qlever-index --version
VOLUME /data
ENTRYPOINT ["python3", "-m", "kgserve"]
CMD ["sync"]
